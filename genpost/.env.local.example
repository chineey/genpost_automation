# ─── Genpost — Environment Variables ───────────────────────────────────────
# Copy this file to .env.local and fill in every value before running the app.
# NEVER commit .env.local to git.

# ── Neon Postgres ─────────────────────────────────────────────────────────────
# Get this from your Neon Console (Dashboard → Connection String)
NEON_DATABASE_URL=postgres://alex:password@ep-cool-flower-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── NextAuth (Auth.js) ────────────────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32 (or any random string)
NEXTAUTH_SECRET=your-nextauth-secret-here
# In dev: http://localhost:3000
# In production: https://yourdomain.com
NEXTAUTH_URL=http://localhost:3000

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ── X / Twitter OAuth 2.0 ────────────────────────────────────────────────────
# From X Developer Portal → Your App → OAuth 2.0 Settings
# Set callback URL to: {NEXT_PUBLIC_APP_URL}/api/auth/x/callback
NEXT_PUBLIC_X_CLIENT_ID=your-x-client-id
X_CLIENT_ID=your-x-client-id
X_CLIENT_SECRET=your-x-client-secret

# ── Token Encryption (AES-256-GCM) ───────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (= 32 bytes = 256 bits)
TOKEN_ENCRYPTION_KEY=your-64-char-hex-encryption-key

# ── Paystack (Billing) ────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_...

# Naira Plans (NGN)
PAYSTACK_STARTER_PLAN_CODE=PLN_...
PAYSTACK_GROWTH_PLAN_CODE=PLN_...
PAYSTACK_AGENCY_PLAN_CODE=PLN_...

# US Dollar Plans (USD)
PAYSTACK_STARTER_USD_PLAN_CODE=PLN_...
PAYSTACK_GROWTH_USD_PLAN_CODE=PLN_...
PAYSTACK_AGENCY_USD_PLAN_CODE=PLN_...

# ── Trigger.dev ───────────────────────────────────────────────────────────────
TRIGGER_SECRET_KEY=tr_dev_...
